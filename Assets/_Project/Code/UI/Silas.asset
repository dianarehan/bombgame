  m_Script: {fileID: 11500000, guid: 751c66f2137f3f747b4be2bf2d5a4a06, type: 3}
  m_Name: Silas
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Silas Thorne
    sentence: "Mr. Rossi. I\u2026 I still can\u2019t believe he\u2019s gone. My deepest
      condolences."
    duration: 10
  - characterName: Silas Thorne
    sentence: The Syndicate is in chaos, naturally. Everyone is looking for a steady
      hand. Someone to... stop the bleeding.
    duration: 12
  - characterName: Silas Thorne
    sentence: "We\u2019ve prepared the office. Kept it exactly as the Don left it.
      Not a single paper moved."
    duration: 10
  - characterName: Silas Thorne
    sentence: "Go on inside. Take the chair. It\u2019s time to see if you can handle
      the pressure of the Don\u2019s legacy. I\u2019ll be right out here... guarding
      your back."
    duration: 10
